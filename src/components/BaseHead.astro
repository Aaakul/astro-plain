---
import SiteConfig from "~/site.config";
---

{/* Global Metadata */}
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<meta name="generator" content={Astro.generator} />
<meta name="color-scheme" content="light dark" />

{/* Apply Theme */}
<script is:inline>
  // @ts-check
  (function () {
    const themeStorageKey = "THEME";

    /**
     * Apply theme preference to a given HTML root element.
     * @param {HTMLElement} rootElement
     */
    const applyThemeToElement = (rootElement) => {
      if (!rootElement) return;
      const theme = localStorage.getItem(themeStorageKey);

      if (theme === "light" || theme === "dark") {
        rootElement.setAttribute("data-color-scheme", theme);
        rootElement.setAttribute(
          "data-theme",
          theme === "light"
            ? (rootElement.dataset.codeThemeLight ?? "github-light")
            : (rootElement.dataset.codeThemeDark ?? "github-dark"),
        );
        rootElement.style.colorScheme = theme;
      } else {
        rootElement.removeAttribute("data-color-scheme");
        rootElement.removeAttribute("data-theme");
        rootElement.style.colorScheme = "";
      }
    };

    const applyTheme = () => {
      applyThemeToElement(document.documentElement);
    };

    // Initial synchronous execution before first paint
    applyTheme();

    /** Pre-inject theme into incoming document before DOM swap to prevent flash
     * @param {any} e */
    const handleBeforeSwap = (e) => {
      if (e?.newDocument?.documentElement) {
        applyThemeToElement(e.newDocument.documentElement);
      }
    };
    document.addEventListener("astro:before-swap", handleBeforeSwap);

    // Ensure live document is in sync immediately after DOM swap
    document.addEventListener("astro:after-swap", applyTheme);
  })();
</script>

{/* Favicons & App Icons */}
<link
  rel="apple-touch-icon"
  type="image/png"
  href={SiteConfig.basePath + "/apple-touch-icon.png"}
  sizes="180x180"
/>
<link rel="icon" type="image/x-icon" href={SiteConfig.basePath + "/favicon.ico"} sizes="32x32" />
<link
  rel="icon"
  type="image/png"
  sizes="180x180"
  href={SiteConfig.basePath + "/apple-touch-icon.png"}
/>
<link rel="icon" type="image/svg+xml" sizes="any" href={SiteConfig.basePath + "/favicon.svg"} />
<link
  rel="mask-icon"
  type="image/svg+xml"
  href={SiteConfig.basePath + "/favicon.svg"}
  color="#0ea5e9"
/>
<link rel="sitemap" href={SiteConfig.basePath + "/sitemap-index.xml"} />
