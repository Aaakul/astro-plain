---
import { DEFAULT_LANG, AVAILABLE_LANG } from "~/i18n";
import SiteConfig, { COOKIE_MAX_AGE } from "~/site.config";

const BASE_PATH = SiteConfig.basePath;
const defaultTarget = `${BASE_PATH ? BASE_PATH : ""}/${DEFAULT_LANG}`;
---

<!doctype html>
<html lang={DEFAULT_LANG}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>Redirecting...</title>

    {/* No-JS fallback: immediately redirect via HTML refresh */}
    <noscript>
      <meta http-equiv="refresh" content={`0;url=${defaultTarget}`} />
    </noscript>

    {/* High-priority redirect: placed at the very top of head to execute before any rendering */}
    <script is:inline define:vars={{ BASE_PATH, DEFAULT_LANG, AVAILABLE_LANG, COOKIE_MAX_AGE }}>
      (function () {
        const COOKIE_NAME = "ASTRO_LANG";

        // Read existing language preference from cookie
        const cookieMatch = document.cookie.match(/(?:^|; )ASTRO_LANG=([^;]+)/);
        const savedLang = cookieMatch ? cookieMatch[1] : null;

        // Match candidate against supported languages (exact -> prefix -> null)
        const findMatch = (lang) => {
          if (!lang) return null;
          if (AVAILABLE_LANG.includes(lang)) return lang;
          const prefix = lang.split("-")[0];
          return AVAILABLE_LANG.find((l) => l.startsWith(prefix)) || null;
        };

        const candidates = savedLang ? [savedLang] : navigator.languages || [navigator.language];
        let targetLang = DEFAULT_LANG;
        for (const lang of candidates) {
          const match = findMatch(lang);
          if (match) {
            targetLang = match;
            break;
          }
        }

        // Save resolved language to cookie on first visit
        if (!savedLang) {
          const maxAge =
            typeof COOKIE_MAX_AGE === "number" && COOKIE_MAX_AGE > 0
              ? `; max-age=${COOKIE_MAX_AGE}`
              : "";
          document.cookie = `${COOKIE_NAME}=${targetLang}${maxAge}; path=/; SameSite=Lax`;
        }

        // Instant navigation without pushing history entry
        window.location.replace((BASE_PATH ? BASE_PATH : "") + "/" + targetLang);
      })();
    </script>

    <style>
      :root {
        color-scheme: light dark;
      }
      body {
        margin: 0;
        background-color: Canvas;
        color: CanvasText;
      }
    </style>
  </head>
  <body></body>
</html>
