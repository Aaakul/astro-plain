# 网站部署 URL
# Site deployment URL
# WebサイトのデプロイURL
SITE_URL=https://example.com

# 子路径部署前缀（例如 /blog，无需末尾斜杠）
# Subpath deployment prefix (e.g. /blog, no trailing slash required)
# サブパスデプロイのプレフィックス（例: /blog、末尾のスラッシュは不要）
BASE_PATH=/blog

# Disqus 评论短域名
# Disqus comment shortname
# Disqus コメントのショートネーム
DISQUS_SHORTNAME=your_disqus_shortname

# 是否启用 Disqus
# Enable Disqus
# Disqus の有効化
DISQUS_ENABLE=true

# Microsoft Clarity 项目 ID
# Microsoft Clarity project ID
# Microsoft Clarity プロジェクト ID
CLARITY_PROJECT_ID=your_clarity_project_id

# 是否启用 Microsoft Clarity
# Enable Microsoft Clarity
# Microsoft Clarity の有効化
CLARITY_ENABLE=true